# Template only. Copy to .env if it does not exist, then configure real providers.
# The app reads process variables; Compose loads .env via env_file.
# Compose uses the postgres service hostname. For a PostgreSQL server running
# directly on the host, replace postgres with localhost.
POSTGRES_DB=upstream_gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://gateway:change-me@postgres:5432/upstream_gateway
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
# All three URLs are required; use HTTPS unless the provider is on loopback.
PROVIDER_A_URL=https://provider-a.example.com/v1/process
PROVIDER_B_URL=https://provider-b.example.com/v1/process
PROVIDER_C_URL=https://provider-c.example.com/v1/process
PROVIDER_A_CONCURRENCY=10
PROVIDER_B_CONCURRENCY=10
PROVIDER_C_CONCURRENCY=10
MAX_UPSTREAM_CONCURRENCY=20
HTTP_MAX_CONNECTIONS=30
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
CONNECT_TIMEOUT_SECONDS=2
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=5
POOL_TIMEOUT_SECONDS=1
TOTAL_DEADLINE_SECONDS=15
MAX_REQUEST_BODY_BYTES=1048576
MAX_RESPONSE_BYTES=1048576
MAX_ATTEMPTS=2
# Enabling this can duplicate operations after a timeout or 5xx response.
RETRY_AMBIGUOUS_FAILURES=false
FAILURE_COOLDOWN_SECONDS=5
RATE_LIMIT_COOLDOWN_SECONDS=30
STATS_WINDOW=50
INITIAL_LATENCY_MS=1000
ERROR_PENALTY_MS=2000
