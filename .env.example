# Environment variables only; this file is not loaded automatically.
DATABASE_URL=sqlite:///./gateway.db
PROVIDER_A_URL=http://92.114.51.251:8001/v1/process
PROVIDER_B_URL=http://92.114.51.251:8002/v1/process
PROVIDER_C_URL=http://92.114.51.251:8003/v1/process
PROVIDER_A_CONCURRENCY=10
PROVIDER_B_CONCURRENCY=10
PROVIDER_C_CONCURRENCY=10
MAX_UPSTREAM_CONCURRENCY=20
HTTP_MAX_CONNECTIONS=30
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
CONNECT_TIMEOUT_SECONDS=2
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=5
